{
  "name": "structural-merge-resolver",
  "displayName": "Structural Merge Resolver",
  "description": "Resolve merge conflicts in JSON, YAML, TOML, XML and list files key by key instead of line by line.",
  "version": "0.2.0",
  "publisher": "ramganesh90",
  "license": "MIT",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "keywords": [
    "merge",
    "conflict",
    "git",
    "json",
    "yaml",
    "toml",
    "xml",
    "merge driver",
    "3-way merge"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "structuralMerge",
          "title": "Merge Conflicts",
          "icon": "media/merge.svg"
        }
      ]
    },
    "views": {
      "structuralMerge": [
        {
          "id": "structuralMerge.conflicts",
          "name": "Conflicted Files",
          "icon": "media/merge.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "structuralMerge.conflicts",
        "contents": "No merge conflicts in this workspace.\n\nWhen a merge leaves conflicts in a JSON, YAML or list file, they appear here and can be resolved key by key."
      }
    ],
    "customEditors": [
      {
        "viewType": "structuralMerge.resolver",
        "displayName": "Structural Merge Resolver",
        "selector": [
          {
            "filenamePattern": "*"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "structuralMerge.resolve",
        "title": "Resolve Conflict Structurally",
        "category": "Structural Merge",
        "icon": "$(git-merge)"
      },
      {
        "command": "structuralMerge.refresh",
        "title": "Refresh",
        "category": "Structural Merge",
        "icon": "$(refresh)"
      },
      {
        "command": "structuralMerge.resolveAllClean",
        "title": "Resolve All Cleanly Mergeable Files",
        "category": "Structural Merge",
        "icon": "$(check-all)"
      },
      {
        "command": "structuralMerge.openInTextEditor",
        "title": "Open in Text Editor",
        "category": "Structural Merge",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "structuralMerge.resolveAllClean",
          "when": "view == structuralMerge.conflicts",
          "group": "navigation@1"
        },
        {
          "command": "structuralMerge.refresh",
          "when": "view == structuralMerge.conflicts",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "structuralMerge.resolve",
          "when": "view == structuralMerge.conflicts && viewItem =~ /^conflict:(structural|clean)$/",
          "group": "inline@1"
        },
        {
          "command": "structuralMerge.openInTextEditor",
          "when": "view == structuralMerge.conflicts && viewItem =~ /^conflict:/",
          "group": "inline@2"
        }
      ],
      "editor/title": [
        {
          "command": "structuralMerge.resolve",
          "when": "structuralMerge.activeFileConflicted",
          "group": "navigation"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "structuralMerge.resolve",
          "when": "scmProvider == git && scmResourceGroup == merge",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "structuralMerge.openInTextEditor",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Structural Merge Resolver",
      "properties": {
        "structuralMerge.showCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show a CodeLens at the top of a conflicted file offering to resolve it structurally."
        },
        "structuralMerge.stageAfterApply": {
          "type": "boolean",
          "default": true,
          "description": "Run `git add` on the file after applying a resolution, marking the conflict resolved."
        },
        "structuralMerge.lockfileStrategy": {
          "type": "string",
          "enum": [
            "ask",
            "regenerate",
            "merge"
          ],
          "default": "ask",
          "enumDescriptions": [
            "Ask each time how to handle a conflicted lockfile.",
            "Regenerate the lockfile with the package manager.",
            "Merge the lockfile key by key (not always correct)."
          ],
          "description": "How to resolve conflicts in package-lock.json and similar lockfiles."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --production && vsce package --no-dependencies",
    "compile-tests": "tsc -p . --outDir out",
    "lint": "eslint src webview",
    "typecheck": "tsc -p . --noEmit",
    "test:unit": "node --test out/src/test/suite/*.unit.test.js",
    "test:integration": "npm run compile-tests && npm run build && node out/src/test/runIntegration.js",
    "test": "npm run compile-tests && npm run test:unit"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "saxes": "^6.0.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.140.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Ramganesh90/crispy-octo-rotary-phone.git"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1f2430",
    "theme": "dark"
  },
  "bugs": {
    "url": "https://github.com/Ramganesh90/crispy-octo-rotary-phone/issues"
  },
  "homepage": "https://github.com/Ramganesh90/crispy-octo-rotary-phone/tree/main/extension"
}
